{
  "name": "shiprocket-react",
  "version": "1.0.1",
  "description": "Full-stack React.js + Server SDK for Shiprocket Shipping and Shiprocket Checkout (Fastrr & Built-in Headless Checkout)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "playground": "node examples/playground-server.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shivendra-99/shiprocket-react.git"
  },
  "homepage": "https://github.com/Shivendra-99/shiprocket-react#readme",
  "bugs": {
    "url": "https://github.com/Shivendra-99/shiprocket-react/issues"
  },
  "author": "Shivendra Kumar Sonkar <sanusonkar1@gmail.com>",
  "keywords": [
    "shiprocket",
    "shiprocket-checkout",
    "fastrr",
    "react",
    "nextjs",
    "shipping",
    "checkout",
    "ecommerce",
    "india"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
