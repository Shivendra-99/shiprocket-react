# ============================================================================
# 1. REQUIRED: Shiprocket Shipping API Credentials
# Where to get: Shiprocket Dashboard -> Settings -> API -> Create an API User
# (Note: Must be a dedicated API user email, NOT your main login email)
# ============================================================================
SHIPROCKET_API_EMAIL=api-user@yourdomain.com
SHIPROCKET_API_PASSWORD=your_shiprocket_api_password

# Your warehouse pickup pincode & location name configured in Shiprocket
SHIPROCKET_PICKUP_PINCODE=110001
SHIPROCKET_PICKUP_LOCATION=Primary

# ============================================================================
# 2. OPTIONAL: Shiprocket Checkout (Fastrr) Credentials
# Required only if using Fastrr 1-Click Checkout (`mode="fastrr"`) or
# Fastrr 100M+ Saved Address OTP Autofill (`enableFastrrAddressPrefill={true}`)
# ============================================================================
FASTRR_API_KEY=your_fastrr_api_key
FASTRR_SECRET_KEY=your_fastrr_hmac_secret_key

# ============================================================================
# 3. OPTIONAL: Webhook Security Token
# Where to get: Shiprocket Dashboard -> Settings -> API -> Webhooks
# ============================================================================
SHIPROCKET_WEBHOOK_SECRET=your_webhook_secret_token
